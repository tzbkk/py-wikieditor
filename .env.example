# .env 文件示例
# 复制此文件为 .env 并填入你的配置

# Wiki 站点配置
FANDOM_DOMAIN=your-wiki.fandom.com
FANDOM_PATH=/zh/

# 机器人账号（在 Special:BotPasswords 创建）
FANDOM_USERNAME=YourBot@BotName
FANDOM_PASSWORD=your_bot_password

# 转换模式（t2s=繁体转简体，s2t=简体转繁体）
CONVERSION_MODE=t2s

# 跳过的字段名（逗号分隔，可选）
# SKIP_FIELDS=图片,圖片

# 视觉分析（vision_analyze 工具）—— 默认自动读取 Pi 登录配置，无需手动设置
# 仅当需要覆盖默认行为时才取消注释：
# VISION_API_KEY=sk-xxxxxxxxxxxx        # 覆盖 Pi auth.json 的 API Key
# VISION_API_BASE=https://api.openai.com/v1  # 覆盖 API 地址
# VISION_MODEL=gpt-4o                   # 覆盖视觉模型名
# VISION_MAX_TOKENS=1000
